        <!-- ===================== H2/HC result ===================== -->
        <Border Style="{StaticResource HighlightCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource MutedText}" Text="H₂/HC Ratio (mol/mol)"/>
                <TextBlock x:Name="TvRatio" Style="{StaticResource BigNumber}" Text="0.0000"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
