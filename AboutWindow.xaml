<Window x:Class="IsomerizationCalc.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حول البرنامج" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource Bg}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Everything here is Arabic and flows right to left -->
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="حاسبة إنتاج وحدة الازمرة" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" Margin="0,0,0,14"/>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,3">
                <Run Text="الإصدار: " FontWeight="SemiBold"/><Run x:Name="RunVersion" Text="1.0"/>
            </TextBlock>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,3">
                <Run Text="المطوّر: " FontWeight="SemiBold"/><Run Text="عبدالسلام جاسم"/>
            </TextBlock>
            <Border Style="{StaticResource Divider}"/>

            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       LineHeight="24"
                       Text="برنامج لحساب إنتاج وحدة الازمرة، ويشمل: الإنتاج والمردود، الرقم الأوكتاني وعامل الأداء، عامل اكس، سرعة الفراغ، ونسبة الهيدروجين إلى الهيدروكربون (باثنين وعشرين مكوّناً للتغذية)."/>
            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       LineHeight="24" Margin="0,8,0,0"
                       Text="يحفظ الملخص في قاعدة بيانات وفي ملف إكسل واحد تُضاف إليه السجلات تباعاً، ويمكن حذف سجل معيّن، وأخذ نسخة احتياطية واسترجاعها، ومعاينة الملخص وطباعته، وتحويل الوحدات المختلفة."/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="TvUpdate" Style="{StaticResource MutedText}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="UpdateButton" Content="البحث عن تحديث" Padding="20,7" Margin="0,0,10,0"
                        Click="Update_Click"/>
                <Button Content="موافق" Padding="26,7" IsDefault="True" IsCancel="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
