<UserControl x:Class="IsomerizationCalc.UnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="#0E1620"
             d:DesignWidth="820" d:DesignHeight="700">
    <StackPanel>
        <!-- ===================== Converter ===================== -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Unit Converter"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Category"/>
                <ComboBox x:Name="CategoryBox" Margin="0,4,0,12" Padding="8,6" DisplayMemberPath="Name"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="From"/>
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ValueBox" Grid.Column="0" Margin="0"/>
                    <ComboBox x:Name="FromBox" Grid.Column="2" Padding="8,6" DisplayMemberPath="Name"/>
                </Grid>

                <Button x:Name="SwapButton" Content="⇅  تبديل" HorizontalAlignment="Center"
                        Padding="18,5" Margin="0,2,0,8" Click="Swap_Click"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="To"/>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource OutCell}" Margin="0">
                        <TextBlock x:Name="TvResult" Style="{StaticResource NumberText}"
                                   HorizontalAlignment="Center" FontSize="18" Text="—"/>
                    </Border>
                    <ComboBox x:Name="ToBox" Grid.Column="2" Padding="8,6" DisplayMemberPath="Name"/>
                </Grid>
                <TextBlock x:Name="TvNote" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===================== The same value in every unit ===================== -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="All units"/>
                <TextBlock x:Name="TvAll" Style="{StaticResource MonoBlock}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
